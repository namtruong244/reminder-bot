# ==========================================
# GITHUB ACTIONS SECRETS (Settings > Secrets and variables > Actions)
# ==========================================
# Cloudflare API Token (quyền: Cloudflare Workers, Cloudflare D1)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Cloudflare Account ID (tùy chọn nếu Wrangler tự nhận diện)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# ==========================================
# CLOUDFLARE WORKER SECRETS (Cài đặt qua lệnh: wrangler secret put <KEY>)
# ==========================================
# Token Bot Telegram từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# Secret Token xác thực Webhook Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_key
# API Key của Google Gemini AI (Google AI Studio)
GEMINI_API_KEY=AIzaSy...
# Khóa 32-byte hex (64 ký tự) dùng để mã hóa AES-256-GCM App-Specific Password của iCloud
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Bearer token bảo mật kết nối từ iOS Shortcuts (tùy chọn)
IOS_BRIDGE_SECRET=your_ios_shortcuts_secret_token
