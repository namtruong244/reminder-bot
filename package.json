{
  "name": "telegram-ios-reminder-bot",
  "version": "1.0.0",
  "description": "Telegram Smart Reminder Bot with Cloudflare Workers, D1, Gemini AI and iOS Reminders sync",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute reminder_bot_db --local --file=./migrations/0001_init_schema.sql",
    "db:migrate:remote": "wrangler d1 execute reminder_bot_db --remote --file=./migrations/0001_init_schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
